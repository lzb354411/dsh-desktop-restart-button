{
  "name": "dsh-desktop-restart-button",
  "version": "1.0.1",
  "private": true,
  "description": "One-click restart for the DeepSeek Harness desktop app: closes the window, exits every process and reopens automatically.",
  "license": "MIT",
  "type": "module",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "desktop",
    "restart"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "restart-dsh.bat",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
